# ==============================================================================
# PERSONA-AGENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WHO THE AGENT REPRESENTS
# USER_NAME is required: the person (or business) the agent speaks for.
# Everything else is optional and simply left out of the page and the prompt when empty.
# WHAT the agent does (its purpose, workflows, forms, UI copy) lives in agent.yaml.
# ------------------------------------------------------------------------------
USER_NAME=""                       # e.g. "Jane Doe" or "Acme Support"
USER_TITLE=""                      # e.g. "Data Scientist"
USER_LOCATION=""                   # e.g. "Berlin, Germany"
USER_EMAIL=""                      # shown to visitors as a fallback contact
USER_SKILLS=""                     # comma-separated topics, e.g. "Python, SQL, Machine Learning"

# Optional: Links to your public profiles and calendar booking page
USER_CALENDAR_URL=""               # e.g. https://cal.com/your-username
USER_LINKEDIN_URL=""
USER_GITHUB_URL=""

# Optional: use a different agent definition (see the examples/ folder)
# AGENT_CONFIG="examples/support-bot.yaml"

# ------------------------------------------------------------------------------
# 2. OPENAI API (Required)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL_NAME="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Optional - Real-time Human-in-the-Loop Escalation)
# When visitors ask complex/unknown questions, persona-agent pings your phone
# via Telegram and awaits your live response (up to 60 seconds).
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 4. PUSHOVER NOTIFICATIONS (Optional - Instant Mobile Lead Alerts)
# Instant push notifications on your phone whenever a lead or meeting is captured.
# ------------------------------------------------------------------------------
PUSHOVER_USER=""
PUSHOVER_TOKEN=""

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD FIRESTORE (Optional - Cloud Lead & Transcript Logging)
# Stores leads in Firestore collections. If omitted, persona-agent logs locally.
# Either place serviceAccountKey.json in root or paste the JSON string below.
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS_JSON=""

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR API (Optional - Automated Google Meet Scheduling)
# Automatically books 30-min intro calls and generates Google Meet links.
# Either place calendar_service_account.json in root or paste JSON string below.
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_CREDENTIALS_JSON=""
GOOGLE_CALENDAR_OWNER_EMAIL=""
MEETING_DEFAULT_TIMEZONE="UTC"

# ------------------------------------------------------------------------------
# 7. SERVER PORT
# ------------------------------------------------------------------------------
PORT=7860

# ------------------------------------------------------------------------------
# 8. CONCURRENCY (Optional)
# How many visitor chats are handled at the same time (Gradio's own default is 1).
# ------------------------------------------------------------------------------
MAX_CONCURRENT_CHATS=10

# ------------------------------------------------------------------------------
# 9. ABUSE / COST GUARDS (Optional - defaults shown)
# A public agent spends your OpenAI credits, so each visitor is limited.
# ------------------------------------------------------------------------------
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_MESSAGES=20
CHAT_MESSAGES_PER_SESSION=30     # per 10 minutes
CHAT_MESSAGES_PER_IP=60          # per 10 minutes

# ------------------------------------------------------------------------------
# 10. MEETING RULES (Optional - defaults shown)
# Visitors can only book inside this window (in MEETING_DEFAULT_TIMEZONE).
# ------------------------------------------------------------------------------
MEETING_START_HOUR=9
MEETING_END_HOUR=18
MEETING_MAX_MINUTES=60
MEETING_MAX_DAYS_AHEAD=60
MEETING_WORKDAYS_ONLY=true

# ------------------------------------------------------------------------------
# 11. PRIVACY NOTICE (Optional - shown in the page footer)
# ------------------------------------------------------------------------------
# PRIVACY_NOTICE="This chat is run by an AI assistant. Messages may be stored and processed by OpenAI."

